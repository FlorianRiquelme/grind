#!/bin/sh
# The fake `claude` at the layout's declared `~/.grind/bin/claude`.
#
# The seam is the binary path, and it is the only seam here: only a real process replays real
# SIGKILL, real empty-not-truncated stdout, a real separate stderr file and a real exit code
# the parent did not choose. A shell script at this path needs no trait and no injection.
#
# It serves one shape per attempt, from a scenario file, and records the argv it was given so
# the literal flags of every attempt can be asserted afterwards.
cat >/dev/null                      # drain the prompt, exactly like the real child
F="${HOME:?}/.fake"
N=$(cat "$F/counter" 2>/dev/null || echo 0)
N=$((N + 1))
echo "$N" > "$F/counter"
{
  for a in "$@"; do printf '%s\n' "$a"; done
  printf -- '--- attempt %s\n' "$N"
} >> "$F/argv.log"
# The transcript Claude Code would write for this session, so a shape can append to it the way
# a real fan-out does. Derived from the record rather than from `$PWD`, and resolved through
# symlinks before slugging — exactly what `view::transcript_path` now does (#82), because
# Claude slugs the path the OS resolves cwd to, not the declared string.
# `PATH` is replaced, so this uses shell globbing and `sed` and nothing else.
RUN_JSON=""
for candidate in "$HOME"/.grind/runs/*/run.json; do
  [ -f "$candidate" ] && RUN_JSON="$candidate"
done
if [ -n "$RUN_JSON" ]; then
  WORKTREE=$(sed -n 's/.*"worktree": *"\([^"]*\)".*/\1/p;' "$RUN_JSON" | sed -n '1p')
  SESSION=$(sed -n 's/.*"session_id": *"\([^"]*\)".*/\1/p;' "$RUN_JSON" | sed -n '1p')
  RESOLVED=$(cd "$WORKTREE" 2>/dev/null && pwd -P)
  SLUG=$(printf '%s' "${RESOLVED:-$WORKTREE}" | sed 's/[^A-Za-z0-9]/-/g')
  printf '%s\n' "$HOME/.claude/projects/$SLUG/$SESSION.jsonl" > "$F/transcript"
fi

SHAPE=$(sed -n "${N}p" "$F/scenario")
[ -n "$SHAPE" ] || SHAPE=$(sed -n '$p' "$F/scenario")
exec "$F/shapes/$SHAPE.sh"
